# Network Reconnaissance Suite Configuration

# API Keys (Optional - for enhanced features)
SHODAN_API_KEY=your_shodan_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
CENSYS_API_ID=your_censys_api_id_here
CENSYS_API_SECRET=your_censys_api_secret_here

# Database Configuration
DATABASE_URL=sqlite:///recon_suite.db

# Flask Configuration
FLASK_SECRET_KEY=change_this_to_random_secret_key
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Scanning Configuration
MAX_CONCURRENT_SCANS=10
SCAN_TIMEOUT=3600
MAX_THREADS=50
RATE_LIMIT_DELAY=0.1

# CVE Database Path
CVE_DATABASE_PATH=data/cve_database.json

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/recon_suite.log

# Security
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
REQUIRE_AUTHENTICATION=True
